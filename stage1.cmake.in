# Auto-configured CMake script - don't modify

set(DIRTY_STR "-dirty")

# Get branch
execute_process(
    COMMAND git branch --show-current
    WORKING_DIRECTORY @WORKSPACE_DIR@
    OUTPUT_VARIABLE GIT_BRANCH
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

# Get full commit hash
execute_process(
    COMMAND git describe --always --dirty=${DIRTY_STR} --abbrev=0
    WORKING_DIRECTORY @WORKSPACE_DIR@
    OUTPUT_VARIABLE GIT_COMMIT_HASH
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

# Get short commit hash
execute_process(
    COMMAND git describe --always --abbrev
    WORKING_DIRECTORY @WORKSPACE_DIR@
    OUTPUT_VARIABLE GIT_COMMIT_HASH_SHORT
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

# Get commit UNIX timestamp in UTC
execute_process(
    COMMAND git show -s --format=%ct
    WORKING_DIRECTORY @WORKSPACE_DIR@
    OUTPUT_VARIABLE GIT_COMMIT_TIMESTAMP
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

# Extract Dirty state
string(FIND ${GIT_COMMIT_HASH} ${DIRTY_STR} GIT_DIRTY)
if(GIT_DIRTY EQUAL -1)
    set(GIT_DIRTY 0)
else()
    set(GIT_DIRTY 1)
    string(REPLACE ${DIRTY_STR} "" GIT_COMMIT_HASH ${GIT_COMMIT_HASH})
endif()

# Create intermediate Git info file
file(WRITE @OUTPUT_PATH@
    "${GIT_BRANCH}\n"
    "${GIT_COMMIT_HASH_SHORT}\n"
    "${GIT_COMMIT_HASH}\n"
    "${GIT_COMMIT_TIMESTAMP}\n"
    "${GIT_DIRTY}\n"
)
